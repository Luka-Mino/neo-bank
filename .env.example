# Moneta environment variables. Copy to .env.local and fill in.
# Startup checks these in src/lib/secrets.ts (validateSecretsAtStartup).
#
# To click around in demo mode you only need the first two blocks.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "true": every screen shows sample data (src/lib/demo-data.ts) and sign-in is
# skipped, so no database or Dakota key is needed.
NEXT_PUBLIC_DEMO_MODE=true

# ─── Always required (even in demo mode) ─────────────────────────────────────
# Session signing secret, at least 16 characters: openssl rand -base64 32
AUTH_SECRET=
# Postgres 16. In demo mode it only has to be a well-formed URL.
# Real use: connect as the restricted role `moneta_app` so row-level security
# applies (roles: scripts/sql/db-roles.sql). Migrations run as the database
# owner instead:  DATABASE_URL=<owner url> npm run db:migrate
DATABASE_URL=postgresql://moneta_app:password@localhost:5432/moneta

# ─── Database extras ─────────────────────────────────────────────────────────
# Role with BYPASSRLS for the allowlisted background jobs (webhooks, reconcile,
# crons, data export). Unset: shares DATABASE_URL (fine locally; in production
# those jobs then see nothing and /api/health flags it).
SYSTEM_DATABASE_URL=
# Connection pool sizes (defaults shown).
# DB_POOL_MAX=5
# DB_SYSTEM_POOL_MAX=2

# ─── Encryption keys (src/lib/crypto/keyring.ts) ─────────────────────────────
# Lists of `id:secret` (first = current), e.g. k1:<random ≥32 chars>.
# Unset: derived from AUTH_SECRET, which is fine for local development.
FIELD_ENCRYPTION_KEYS=
HMAC_KEYS=

# ─── Dakota (docs.dakota.xyz) ────────────────────────────────────────────────
# Required in production unless demo mode is on.
DAKOTA_API_KEY=
DAKOTA_ENV=sandbox
# Dakota's webhook signing public key (64 hex chars), from Dakota's dashboard
# for your environment.
DAKOTA_WEBHOOK_PUBLIC_KEY=
# Written by `npm run dakota:bootstrap` (once per environment, after you have
# an API key). The private key is the platform signer (base64 PKCS#8 PEM,
# P-256) that signs wallet sends.
DAKOTA_SIGNER_PRIVATE_KEY=
DAKOTA_SIGNER_GROUP_ID=
DAKOTA_POLICY_ID=
DAKOTA_NETWORK_ID=base-sepolia
# Order the reconcile job reads Dakota's event list in: oldest (default) | newest.
# DAKOTA_EVENTS_ORDER=oldest

# ─── Feature switches ────────────────────────────────────────────────────────
# Card issuer: mock (default: fake card numbers, no calls) | dakota.
ISSUING_PROVIDER=mock
# Side accounts: shared (default: they share the main wallet) | dakota (each
# gets its own Dakota wallet; needs the sandbox). See SIDE-ACCOUNTS-PLAN.md.
SIDE_ACCOUNT_WALLETS=shared
# Development only: treat every signed-in user as identity-verified. Ignored
# when NODE_ENV=production (src/lib/auth/kyc-bypass.ts).
BYPASS_KYC=false

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token the cron routes require (vercel.json). Required in production.
CRON_SECRET=

# ─── Email (src/lib/email.ts) ────────────────────────────────────────────────
# Nothing set: emails are logged, not sent, and email verification is off.
# EMAIL_PROVIDER=resend   # resend (default) | smtp
RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@host:587
EMAIL_FROM=Moneta <notifications@moneta.example>
# Inbox that gets a copy of every Help & support request. Unset: requests are
# still saved, with a warning in the log.
SUPPORT_EMAIL=

# ─── Shared rate limits (src/lib/rate-limit.ts) ──────────────────────────────
# Unset: per-instance memory limits (fine locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error monitoring (Sentry) ───────────────────────────────────────────────
# Unset: monitoring is off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
